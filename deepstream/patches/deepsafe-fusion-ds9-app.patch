diff --git a/deepstream_parallel_infer_app.cpp b/deepstream_parallel_infer_app.cpp
index 2e938ba..d7e5d01 100755
--- a/deepstream_parallel_infer_app.cpp
+++ b/deepstream_parallel_infer_app.cpp
@@ -14,6 +14,7 @@
  * limitations under the License.
  */
 #include "deepstream_parallel_infer.h"
+#include "deepstream_fusion_hook.hpp"
 #include "post_process/body_pose/post_process.cpp"
 #include "nvds_version.h"
 
@@ -1333,6 +1334,8 @@ int main(int argc, char *argv[])
   guint i;
   const gchar *new_mux_str = NULL;
   gboolean use_new_mux = FALSE;
+  DeepsafeFusionAppHook *fusion_hook = NULL;
+  gchar fusion_error[512] = {0};
 
   ctx = g_option_context_new ("Nvidia DeepStream Parallel Demo");
   group = g_option_group_new ("abc", NULL, NULL, NULL, NULL);
@@ -1387,6 +1390,14 @@ int main(int argc, char *argv[])
   gst_init(&argc, &argv);
   main_loop = g_main_loop_new(NULL, FALSE);
 
+  fusion_hook = deepsafe_fusion_app_hook_create(
+      fusion_error, sizeof (fusion_error));
+  if (!fusion_hook) {
+    NVGSTDS_ERR_MSG_V ("DeepSafe fusion initialization failed: %s", fusion_error);
+    return_value = -1;
+    goto done;
+  }
+
   /* Create gstreamer elements */
   /* Create Pipeline element that will form a connection of other elements */
   instance_bin = &appCtx->pipeline.instance_bins[0];
@@ -1441,6 +1452,13 @@ int main(int argc, char *argv[])
       g_print ("creating parallel infer bin failed\n");
       goto done;
   }
+  if (!deepsafe_fusion_app_hook_install(
+          fusion_hook, pipeline->parallel_infer_bin.muxer,
+          config->num_source_sub_bins, fusion_error, sizeof (fusion_error))) {
+    NVGSTDS_ERR_MSG_V ("DeepSafe fusion probe installation failed: %s", fusion_error);
+    return_value = -1;
+    goto done;
+  }
   gst_bin_add (GST_BIN (pipeline->pipeline), pipeline->parallel_infer_bin.bin);
   last_elem = pipeline->parallel_infer_bin.bin;
   NVGSTDS_LINK_ELEMENT (pipeline->multi_src_bin.bin, last_elem);
@@ -1584,9 +1602,15 @@ done:
 
   g_print ("Quitting\n");
   if (bus_watch_id) {
     g_print("Returned, stopping playback\n");
     gst_element_set_state(pipeline->pipeline, GST_STATE_NULL);
+  }
+
+  deepsafe_fusion_app_hook_destroy(fusion_hook);
+  fusion_hook = NULL;
+
+  if (bus_watch_id) {
     g_print("Deleting pipeline\n");
     gst_object_unref(GST_OBJECT(pipeline->pipeline));
     g_source_remove(bus_watch_id);
   }
